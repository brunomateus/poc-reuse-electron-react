{
  "name": "@poc-reuso/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Electron desktop app (macOS) built on @poc-reuso/ui",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:node && node dist-electron/scripts/dev.js",
    "build": "npm run build:renderer && npm run build:node",
    "build:renderer": "vite build",
    "build:node": "tsc -p tsconfig.node.json",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@poc-reuso/ui": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.11.16",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
