{
  "name": "poc-reuso",
  "version": "0.1.0",
  "private": true,
  "description": "PoC: reusing React components between a web app and an Electron desktop app (macOS)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @poc-reuso/desktop",
    "dev:web": "npm run dev -w @poc-reuso/web",
    "build": "npm run build --workspaces --if-present",
    "build:desktop": "npm run build -w @poc-reuso/desktop",
    "build:web": "npm run build -w @poc-reuso/web",
    "preview:web": "npm run preview -w @poc-reuso/web",
    "start": "npm run start -w @poc-reuso/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run check:boundaries",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
